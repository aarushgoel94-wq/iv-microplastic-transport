        "## Optional — Compare Safe vs. Degraded side-by-side"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def run_container_comparison(base_trials=10):\n",
        "    results = {}\n",
        "    for key in [\"pristine\", \"autoclaved\"]:\n",
        "        c = get_container_profile(key)\n",
        "        r = ExperimentRunner(env, c, base_trials_per_size=base_trials, seed=SEED, verbose=False)\n",
        "        results[key] = (c, r.run_all(), r.data_log, r.injection_plan)\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(14, 5), sharey=True)\n",
        "    for ax, (key, (c, groups, log, _)) in zip(axes, results.items()):\n",
        "        diameters = [g.diameter_um for g in groups]\n",
        "        x = np.arange(len(diameters)); w = 0.35\n",
        "        esc = [log.get_tally(g.diameter_um).escaped_percent for g in groups]\n",
        "        stk = [log.get_tally(g.diameter_um).stuck_percent for g in groups]\n",
        "        ax.bar(x - w/2, esc, w, label=\"Escape\", color=\"#4c72b0\")\n",
        "        ax.bar(x + w/2, stk, w, label=\"Stuck\", color=\"#c44e52\")\n",
        "        ax.set_xticks(x); ax.set_xticklabels([f\"{d:.0f}µm\" for d in diameters])\n",
        "        ax.set_title(f\"{c.comparison_label}\\n{c.display_name}\")\n",
        "        ax.set_ylim(0, 105); ax.legend(); ax.grid(axis=\"y\", alpha=0.5)\n",
        "    axes[0].set_ylabel(\"Percentage of trials (%)\")\n",
        "    fig.suptitle(\"Safe vs. Sterilization-Degraded Container Comparison\", fontsize=14)\n",
        "    fig.tight_layout(); plt.show()\n",
        "\n",
        "run_container_comparison(base_trials=10)  # increase to 100 for full run"
      ],
      "execution_count": null,
      "outputs": []
    }
