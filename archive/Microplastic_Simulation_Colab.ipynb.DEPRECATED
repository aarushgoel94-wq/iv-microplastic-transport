{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Microplastic Particle Simulation in Medical Tubing\n",
        "\n",
        "2D physics simulation: Poiseuille flow, Stokes drag, buoyancy/gravity, wall collisions.\n",
        "\n",
        "**Run cells top-to-bottom.** Set `CONTAINER_KEY` in the final cell to `\"pristine\"` or `\"autoclaved\"`."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "!pip install -q numpy matplotlib"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cell 1 — Imports & physical constants"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from __future__ import annotations\n",
        "\n",
        "from dataclasses import dataclass, field\n",
        "from enum import Enum\n",
        "from pathlib import Path\n",
        "from typing import Dict, List, Optional, Tuple\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "EXPERIMENTAL_DIAMETERS_UM: Tuple[float, ...] = (3.0, 10.0, 50.0)\n",
        "TRIALS_PER_GROUP: int = 100\n",
        "SUB_DANGEROUS_SIZE_THRESHOLD_UM: float = 20.0\n",
        "\n",
        "GRAVITY = 9.81\n",
        "POLYPROPYLENE_DENSITY = 905.0\n",
        "SALINE_DENSITY = 1000.0\n",
        "SALINE_DYNAMIC_VISCOSITY = 1.0e-3\n",
        "BLOOD_DENSITY = 1060.0\n",
        "BLOOD_DYNAMIC_VISCOSITY = 3.5e-3\n",
        "\n",
        "# Euler integration limits (dt in seconds)\n",
        "EULER_RELAXATION_STEPS = 50\n",
        "EULER_CFL_FRACTION = 0.1\n",
        "EULER_WALL_SAFETY = 0.25\n",
        "DT_MIN = 1e-9\n",
        "DT_MAX = 1e-5\n",
        "MAX_TRAJECTORY_POINTS = 10_000\n",
        "MAX_PHYSICS_STEPS = 500_000\n",
        "DEFAULT_MAX_TIME_S = 20.0\n",
        "\n",
        "DRAG_LOCK_BETA_DT = 5.0\n",
        "TUBULE_LATERAL_RELAX_RATE = 100.0\n",
        "REFERENCE_FOCUS_DIAMETER_UM = 50.0\n",
        "\n",
        "\n",
        "class ParticleState(str, Enum):\n",
        "    FLOWING = \"flowing\"\n",
        "    ESCAPED = \"escaped\"\n",
        "    STUCK = \"stuck\"\n",
        "\n",
        "\n",
        "def diameter_um_to_radius_m(diameter_um: float) -> float:\n",
        "    return (diameter_um * 1e-6) / 2.0"
      ],
      "execution_count": null,
      "outputs": [],
      "id": "9cbcec16"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cell 2 — Container profiles (sterilization history)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@dataclass(frozen=True)\n",
        "class ContainerProfile:\n",
        "    key: str\n",
        "    display_name: str\n",
        "    comparison_label: str\n",
        "    degradation_factor: float\n",
        "    size_weights: Dict[float, float]\n",
        "\n",
        "    def normalized_weights(self, diameters_um: Tuple[float, ...]) -> Dict[float, float]:\n",
        "        weights = {d: self.size_weights.get(d, 0.0) for d in diameters_um}\n",
        "        total = sum(weights.values())\n",
        "        if total <= 0.0:\n",
        "            raise ValueError(f\"Container profile '{self.key}' has no positive size weights.\")\n",
        "        return {d: w / total for d, w in weights.items()}\n",
        "\n",
        "    def trial_counts(\n",
        "        self,\n",
        "        diameters_um: Tuple[float, ...] = EXPERIMENTAL_DIAMETERS_UM,\n",
        "        base_trials_per_size: int = TRIALS_PER_GROUP,\n",
        "    ) -> Dict[float, int]:\n",
        "        normalized = self.normalized_weights(diameters_um)\n",
        "        total_budget = int(round(base_trials_per_size * len(diameters_um) * self.degradation_factor))\n",
        "        raw = {d: total_budget * normalized[d] for d in diameters_um}\n",
        "        counts = {d: max(1, int(round(n))) for d, n in raw.items()}\n",
        "        diff = total_budget - sum(counts.values())\n",
        "        if diff != 0:\n",
        "            adjust_d = max(diameters_um, key=lambda d: raw[d])\n",
        "            counts[adjust_d] = max(1, counts[adjust_d] + diff)\n",
        "        return counts\n",
        "\n",
        "    def injection_summary(\n",
        "        self,\n",
        "        diameters_um: Tuple[float, ...] = EXPERIMENTAL_DIAMETERS_UM,\n",
        "        base_trials_per_size: int = TRIALS_PER_GROUP,\n",
        "    ) -> dict:\n",
        "        counts = self.trial_counts(diameters_um, base_trials_per_size)\n",
        "        total = sum(counts.values())\n",
        "        sub_threshold = sum(n for d, n in counts.items() if d < SUB_DANGEROUS_SIZE_THRESHOLD_UM)\n",
        "        return {\n",
        "            \"container_key\": self.key,\n",
        "            \"container_name\": self.display_name,\n",
        "            \"comparison_label\": self.comparison_label,\n",
        "            \"degradation_factor\": self.degradation_factor,\n",
        "            \"trial_counts\": counts,\n",
        "            \"total_particles\": total,\n",
        "            \"sub_20um_particles\": sub_threshold,\n",
        "            \"sub_20um_fraction\": sub_threshold / total if total else 0.0,\n",
        "            \"baseline_total\": base_trials_per_size * len(diameters_um),\n",
        "        }\n",
        "\n",
        "\n",
        "CONTAINER_PROFILES: Dict[str, ContainerProfile] = {\n",
        "    \"pristine\": ContainerProfile(\n",
        "        key=\"pristine\",\n",
        "        display_name=\"Pristine / Standard Container\",\n",
        "        comparison_label=\"Safe\",\n",
        "        degradation_factor=1.0,\n",
        "        size_weights={3.0: 1.0, 10.0: 1.0, 50.0: 1.0},\n",
        "    ),\n",
        "    \"autoclaved\": ContainerProfile(\n",
        "        key=\"autoclaved\",\n",
        "        display_name=\"Autoclaved / Harsh Sterilization Container\",\n",
        "        comparison_label=\"Sterilization-Degraded\",\n",
        "        degradation_factor=2.5,\n",
        "        size_weights={3.0: 2.8, 10.0: 2.2, 50.0: 0.35},\n",
        "    ),\n",
        "}\n",
        "\n",
        "\n",
        "def get_container_profile(key: str) -> ContainerProfile:\n",
        "    normalized = key.strip().lower().replace(\" \", \"_\")\n",
        "    aliases = {\"standard\": \"pristine\", \"safe\": \"pristine\", \"harsh\": \"autoclaved\", \"gamma\": \"autoclaved\"}\n",
        "    resolved = aliases.get(normalized, normalized)\n",
        "    if resolved not in CONTAINER_PROFILES:\n",
        "        raise ValueError(f\"Unknown container '{key}'. Use: {list(CONTAINER_PROFILES)}\")\n",
        "    return CONTAINER_PROFILES[resolved]"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cell 3 — Tube environment & particle physics"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@dataclass\n",
        "class FluidProperties:\n",
        "    density: float = SALINE_DENSITY\n",
        "    dynamic_viscosity: float = SALINE_DYNAMIC_VISCOSITY\n",
        "    average_velocity: float = 0.05\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class TubeEnvironment:\n",
        "    length: float = 0.100\n",
        "    width: float = 0.004\n",
        "    fluid: FluidProperties = field(default_factory=FluidProperties)\n",
        "\n",
        "    @property\n",
        "    def centerline_y(self) -> float:\n",
        "        return self.width / 2.0\n",
        "\n",
        "    @property\n",
        "    def max_centerline_velocity(self) -> float:\n",
        "        return 1.5 * self.fluid.average_velocity\n",
        "\n",
        "    def axial_velocity(self, y: float) -> float:\n",
        "        half_width = self.width / 2.0\n",
        "        normalized = (y - self.centerline_y) / half_width\n",
        "        return self.max_centerline_velocity * (1.0 - normalized**2)\n",
        "\n",
        "    def fluid_velocity_at(self, position: np.ndarray) -> np.ndarray:\n",
        "        return np.array([self.axial_velocity(float(position[1])), 0.0])\n",
        "\n",
        "    def verify_parabolic_profile(self) -> None:\n",
        "        assert abs(self.axial_velocity(0.0)) < 1e-15\n",
        "        assert abs(self.axial_velocity(self.width)) < 1e-15\n",
        "        assert self.axial_velocity(self.centerline_y) == self.max_centerline_velocity\n",
        "\n",
        "    def sphere_bottom_y(self, center_y, radius):\n",
        "        return center_y - radius\n",
        "\n",
        "    def sphere_top_y(self, center_y, radius):\n",
        "        return center_y + radius\n",
        "\n",
        "    def wall_clearances(self, position, radius):\n",
        "        _, y = position\n",
        "        return y - radius, self.width - (y + radius)\n",
        "\n",
        "    def wall_contact_thresholds(self, radius):\n",
        "        return {'bottom_contact_y_m': radius, 'top_contact_y_m': self.width - radius,\n",
        "                'interior_band_m': self.width - 2.0 * radius, 'radius_m': radius}\n",
        "\n",
        "    def check_wall_collision(self, position, radius):\n",
        "        _, y = position\n",
        "        return self.sphere_bottom_y(y, radius) <= 0.0 or self.sphere_top_y(y, radius) >= self.width\n",
        "\n",
        "    def snap_to_wall_contact(self, position, radius):\n",
        "        pos = position.copy()\n",
        "        _, y = pos\n",
        "        penetration_bottom = radius - y\n",
        "        penetration_top = (y + radius) - self.width\n",
        "        if penetration_bottom > 0.0 and penetration_top > 0.0:\n",
        "            pos[1] = self.width - radius if penetration_top >= penetration_bottom else radius\n",
        "        elif penetration_bottom > 0.0:\n",
        "            pos[1] = radius\n",
        "        elif penetration_top > 0.0:\n",
        "            pos[1] = self.width - radius\n",
        "        return pos\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Particle:\n",
        "    position: np.ndarray\n",
        "    velocity: np.ndarray = field(default_factory=lambda: np.zeros(2))\n",
        "    diameter_um: float = 0.0\n",
        "    density: float = POLYPROPYLENE_DENSITY\n",
        "    state: ParticleState = ParticleState.FLOWING\n",
        "    id: int = 0\n",
        "\n",
        "    def __post_init__(self) -> None:\n",
        "        self.position = np.asarray(self.position, dtype=float)\n",
        "        self.velocity = np.asarray(self.velocity, dtype=float)\n",
        "        if self.diameter_um <= 0.0:\n",
        "            raise ValueError(\"Particle requires a positive diameter_um.\")\n",
        "        r = self.radius\n",
        "        self._volume_m3 = (4.0 / 3.0) * np.pi * r**3\n",
        "        self._mass_kg = self.density * self._volume_m3\n",
        "\n",
        "    @property\n",
        "    def radius(self) -> float:\n",
        "        return diameter_um_to_radius_m(self.diameter_um)\n",
        "\n",
        "    @property\n",
        "    def mass(self) -> float:\n",
        "        return self._mass_kg\n",
        "\n",
        "    @property\n",
        "    def volume(self) -> float:\n",
        "        return self._volume_m3\n",
        "\n",
        "    @classmethod\n",
        "    def from_diameter_um(cls, diameter_um: float, position: np.ndarray, *, trial_id: int = 0) -> Particle:\n",
        "        return cls(position=position, diameter_um=float(diameter_um), id=trial_id)\n",
        "\n",
        "    def stokes_drag_coefficient(self, dynamic_viscosity: float) -> float:\n",
        "        return 6.0 * np.pi * dynamic_viscosity * self.radius\n",
        "\n",
        "    def compute_forces(self, environment: TubeEnvironment) -> np.ndarray:\n",
        "        mu = environment.fluid.dynamic_viscosity\n",
        "        rho_f = environment.fluid.density\n",
        "        fluid_velocity = environment.fluid_velocity_at(self.position)\n",
        "        drag_force = self.stokes_drag_coefficient(mu) * (fluid_velocity - self.velocity)\n",
        "        gravity_force = np.array([0.0, -self.mass * GRAVITY])\n",
        "        buoyancy_force = np.array([0.0, rho_f * self.volume * GRAVITY])\n",
        "        return drag_force + gravity_force + buoyancy_force\n",
        "\n",
        "    def acceleration(self, environment: TubeEnvironment) -> np.ndarray:\n",
        "        return self.compute_forces(environment) / self.mass\n",
        "\n",
        "    def terminal_buoyancy_rise_velocity(self, fluid_density: float, dynamic_viscosity: float) -> float:\n",
        "        return 2.0 * self.radius**2 * (fluid_density - self.density) * GRAVITY / (9.0 * dynamic_viscosity)\n",
        "\n",
        "    def stokes_drag_rate(self, dynamic_viscosity: float) -> float:\n",
        "        \"\"\"β = (6πμr)/m ∝ 1/r² — small particles lock to fluid; large particles lag.\"\"\"\n",
        "        return self.stokes_drag_coefficient(dynamic_viscosity) / self.mass\n",
        "\n",
        "    def net_body_acceleration_y(self, fluid_density: float) -> float:\n",
        "        return (fluid_density - self.density) / self.density * GRAVITY\n",
        "\n",
        "    def apply_tubule_centerline_focus(self, environment, y_m, dynamic_viscosity, dt):\n",
        "        beta = self.stokes_drag_rate(dynamic_viscosity)\n",
        "        beta_ref = 9.0 * dynamic_viscosity / (2.0 * self.density * (diameter_um_to_radius_m(REFERENCE_FOCUS_DIAMETER_UM) ** 2))\n",
        "        if beta <= beta_ref:\n",
        "            return y_m\n",
        "        y_c = environment.centerline_y\n",
        "        lateral_rate = TUBULE_LATERAL_RELAX_RATE * np.log1p(beta / beta_ref)\n",
        "        focus_blend = 1.0 - np.exp(-lateral_rate * dt)\n",
        "        return y_m + focus_blend * (y_c - y_m)\n",
        "\n",
        "    def _stick_to_wall(self, environment: TubeEnvironment) -> None:\n",
        "        r = self.radius\n",
        "        self.state = ParticleState.STUCK\n",
        "        self.position[:] = environment.snap_to_wall_contact(self.position, r)\n",
        "        self.velocity[:] = 0.0\n",
        "\n",
        "    def update(self, environment: TubeEnvironment, dt: float) -> None:\n",
        "        if self.state != ParticleState.FLOWING:\n",
        "            return\n",
        "        if environment.check_wall_collision(self.position, self.radius):\n",
        "            self._stick_to_wall(environment)\n",
        "            return\n",
        "        mu = environment.fluid.dynamic_viscosity\n",
        "        rho_f = environment.fluid.density\n",
        "        beta = self.stokes_drag_rate(mu)\n",
        "        a_body_y = self.net_body_acceleration_y(rho_f)\n",
        "        v_term_y = a_body_y / beta\n",
        "        v0 = self.velocity.copy()\n",
        "        decay = np.exp(-beta * dt)\n",
        "        drift_factor = (1.0 - decay) / beta if beta > 1e-30 else dt\n",
        "        y0 = float(self.position[1])\n",
        "        self.velocity[1] = v_term_y + (v0[1] - v_term_y) * decay\n",
        "        dy = v_term_y * dt + (v0[1] - v_term_y) * drift_factor\n",
        "        y1 = self.apply_tubule_centerline_focus(environment, y0 + dy, mu, dt)\n",
        "        self.position[1] = y1\n",
        "        u_stream = environment.axial_velocity(0.5 * (y0 + y1))\n",
        "        if beta * dt >= DRAG_LOCK_BETA_DT:\n",
        "            self.velocity[0] = u_stream\n",
        "        else:\n",
        "            self.velocity[0] = u_stream + (v0[0] - u_stream) * decay\n",
        "        self.position[0] += u_stream * dt + (v0[0] - u_stream) * drift_factor\n",
        "        if environment.check_wall_collision(self.position, self.radius):\n",
        "            self._stick_to_wall(environment)\n",
        "            return\n",
        "        if self.position[0] - self.radius >= environment.length:\n",
        "            self.state = ParticleState.ESCAPED\n",
        "            return\n",
        "        if self.position[0] < self.radius:\n",
        "            self.position[0] = self.radius\n",
        "            self.velocity[0] = max(self.velocity[0], 0.0)\n",
        "\n",
        "\n",
        "def verify_particle_size_scaling(diameters_um=EXPERIMENTAL_DIAMETERS_UM):\n",
        "    env = TubeEnvironment()\n",
        "    print(\"Particle size scaling check:\")\n",
        "    for d in diameters_um:\n",
        "        p = Particle.from_diameter_um(d, np.array([0.0, env.centerline_y]))\n",
        "        print(f\"  {d:4.0f} µm  mass={p.mass:.3e} kg  drag={p.stokes_drag_coefficient(env.fluid.dynamic_viscosity):.3e}  v_rise={p.terminal_buoyancy_rise_velocity(env.fluid.density, env.fluid.dynamic_viscosity)*1e6:.1f} µm/s\")"
      ],
      "execution_count": null,
      "outputs": [],
      "id": "252e5667"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Cell 4 — Data logging & experiment runner"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def normalize_diameter_um(diameter_um):\n",
        "    return float(diameter_um)\n",
        "\n",
        "\n",
        "def random_inlet_y(environment, radius, rng):\n",
        "    return float(rng.uniform(radius, environment.width - radius))\n",
        "\n",
        "\n",
        "def create_inlet_particle(environment, diameter_um, rng, trial_id=0):\n",
        "    diameter_um = normalize_diameter_um(diameter_um)\n",
        "    radius = diameter_um_to_radius_m(diameter_um)\n",
        "    y = random_inlet_y(environment, radius, rng)\n",
        "    particle = Particle.from_diameter_um(diameter_um, np.array([radius, y]), trial_id=trial_id)\n",
        "    if particle.diameter_um != diameter_um:\n",
        "        raise RuntimeError(f'Diameter mismatch: requested {diameter_um}, got {particle.diameter_um}')\n",
        "    return particle\n",
        "\n",
        "\n",
        "def debug_print_particle_physics(environment, diameter_um, label=''):\n",
        "    diameter_um = normalize_diameter_um(diameter_um)\n",
        "    radius = diameter_um_to_radius_m(diameter_um)\n",
        "    probe = Particle.from_diameter_um(diameter_um, np.array([radius, environment.centerline_y]))\n",
        "    mu = environment.fluid.dynamic_viscosity\n",
        "    drag = probe.stokes_drag_coefficient(mu) * np.array([0.05, 0.0])\n",
        "    print(f'  [DEBUG {label} d={diameter_um:.0f} µm] particle.diameter_um={probe.diameter_um:.1f}  mass={probe.mass:.4e} kg  |F_drag|={np.linalg.norm(drag):.4e} N')\n",
        "    return probe\n",
        "\n",
        "\n",
        "def debug_compare_reference_particles(environment):\n",
        "    print('\\n  [DEBUG] Physics check — 3 µm vs 50 µm (must differ before trials):')\n",
        "    p3 = debug_print_particle_physics(environment, 3.0, label='small')\n",
        "    p50 = debug_print_particle_physics(environment, 50.0, label='large')\n",
        "    mu = environment.fluid.dynamic_viscosity\n",
        "    rho_f = environment.fluid.density\n",
        "    print(f'  [DEBUG] Mass ratio (50/3 µm): {p50.mass/p3.mass:.1f}×  drag_coeff ratio: {p50.stokes_drag_coefficient(mu)/p3.stokes_drag_coefficient(mu):.1f}×')\n",
        "    print(f'  [DEBUG] Drag coupling β (3/50 µm)={p3.stokes_drag_rate(mu)/p50.stokes_drag_rate(mu):.0f}×')\n",
        "    print(f'  [DEBUG] Terminal wall drift: 3 µm={p3.terminal_buoyancy_rise_velocity(rho_f, mu)*1e6:.2f} µm/s  50 µm={p50.terminal_buoyancy_rise_velocity(rho_f, mu)*1e6:.1f} µm/s')\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class TrajectoryLog:\n",
        "    time_s: np.ndarray\n",
        "    x_m: np.ndarray\n",
        "    y_m: np.ndarray\n",
        "\n",
        "    def __post_init__(self):\n",
        "        self.time_s = np.asarray(self.time_s, dtype=float)\n",
        "        self.x_m = np.asarray(self.x_m, dtype=float)\n",
        "        self.y_m = np.asarray(self.y_m, dtype=float)\n",
        "\n",
        "    @property\n",
        "    def x_mm(self): return self.x_m * 1e3\n",
        "    @property\n",
        "    def y_mm(self): return self.y_m * 1e3\n",
        "\n",
        "    @classmethod\n",
        "    def from_samples(cls, times, x_coords, y_coords):\n",
        "        return cls(time_s=np.array(times), x_m=np.array(x_coords), y_m=np.array(y_coords))\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class DiscreteOutcomeTally:\n",
        "    diameter_um: float\n",
        "    escaped: int = 0\n",
        "    stuck: int = 0\n",
        "    incomplete: int = 0\n",
        "\n",
        "    @property\n",
        "    def total(self): return self.escaped + self.stuck + self.incomplete\n",
        "\n",
        "    def record(self, state):\n",
        "        if state == ParticleState.ESCAPED: self.escaped += 1\n",
        "        elif state == ParticleState.STUCK: self.stuck += 1\n",
        "        else: self.incomplete += 1\n",
        "\n",
        "    @property\n",
        "    def escaped_percent(self): return 100.0 * self.escaped / self.total if self.total else 0.0\n",
        "    @property\n",
        "    def stuck_percent(self): return 100.0 * self.stuck / self.total if self.total else 0.0\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class ExperimentDataLog:\n",
        "    tallies: Dict[float, DiscreteOutcomeTally] = field(default_factory=dict)\n",
        "    trajectories: Dict[float, List[TrajectoryLog]] = field(default_factory=dict)\n",
        "\n",
        "    def register_group(self, diameter_um):\n",
        "        diameter_um = normalize_diameter_um(diameter_um)\n",
        "        if diameter_um not in self.tallies:\n",
        "            self.tallies[diameter_um] = DiscreteOutcomeTally(diameter_um=diameter_um)\n",
        "            self.trajectories[diameter_um] = []\n",
        "\n",
        "    def reset_group(self, diameter_um):\n",
        "        diameter_um = normalize_diameter_um(diameter_um)\n",
        "        self.tallies[diameter_um] = DiscreteOutcomeTally(diameter_um=diameter_um)\n",
        "        self.trajectories[diameter_um] = []\n",
        "\n",
        "    def reset_all(self):\n",
        "        self.tallies.clear()\n",
        "        self.trajectories.clear()\n",
        "\n",
        "    def record_trial(self, diameter_um, final_state, trajectory):\n",
        "        diameter_um = normalize_diameter_um(diameter_um)\n",
        "        self.register_group(diameter_um)\n",
        "        self.tallies[diameter_um].record(final_state)\n",
        "        self.trajectories[diameter_um].append(trajectory)\n",
        "\n",
        "    def get_tally(self, diameter_um):\n",
        "        diameter_um = normalize_diameter_um(diameter_um)\n",
        "        self.register_group(diameter_um)\n",
        "        return self.tallies[diameter_um]\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class TrialResult:\n",
        "    trial_id: int\n",
        "    diameter_um: float\n",
        "    initial_y_m: float\n",
        "    final_state: ParticleState\n",
        "    transit_time_s: float\n",
        "    final_position: np.ndarray\n",
        "    final_velocity: np.ndarray\n",
        "    trajectory: TrajectoryLog\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class GroupResult:\n",
        "    diameter_um: float\n",
        "    trials: List[TrialResult]\n",
        "    planned_trials: Optional[int] = None\n",
        "\n",
        "    @property\n",
        "    def n_trials(self): return len(self.trials)\n",
        "    @property\n",
        "    def escape_count(self): return sum(1 for t in self.trials if t.final_state == ParticleState.ESCAPED)\n",
        "    @property\n",
        "    def stuck_count(self): return sum(1 for t in self.trials if t.final_state == ParticleState.STUCK)\n",
        "    @property\n",
        "    def escape_fraction(self): return self.escape_count / self.n_trials if self.n_trials else 0.0\n",
        "    @property\n",
        "    def stuck_fraction(self): return self.stuck_count / self.n_trials if self.n_trials else 0.0\n",
        "\n",
        "\n",
        "def stokes_relaxation_time(radius, dynamic_viscosity, density=POLYPROPYLENE_DENSITY):\n",
        "    return 2.0 * density * radius**2 / (9.0 * dynamic_viscosity)\n",
        "\n",
        "\n",
        "def stokes_drag_rate_from_radius(radius, dynamic_viscosity, density=POLYPROPYLENE_DENSITY):\n",
        "    return 9.0 * dynamic_viscosity / (2.0 * density * radius ** 2)\n",
        "\n",
        "\n",
        "def verify_parabolic_flow_profile(environment):\n",
        "    environment.verify_parabolic_profile()\n",
        "    print('\\n  [DEBUG] Parabolic flow profile u(y):')\n",
        "    print(f'    u_wall={environment.axial_velocity(0.0)*1e3:.2f} mm/s  u_center={environment.axial_velocity(environment.centerline_y)*1e3:.2f} mm/s')\n",
        "\n",
        "\n",
        "def compute_euler_timestep(particle, environment, fixed_dt=None, fast_mode=False, analytic_stokes=True):\n",
        "    cap = min(DT_MAX * 5.0, 5e-5) if fast_mode else DT_MAX\n",
        "    if fixed_dt is not None:\n",
        "        return float(np.clip(fixed_dt, DT_MIN, cap))\n",
        "    mu = environment.fluid.dynamic_viscosity\n",
        "    r = particle.radius\n",
        "    tau = stokes_relaxation_time(r, mu, particle.density)\n",
        "    ref_speed = max(np.linalg.norm(particle.velocity),\n",
        "                    np.linalg.norm(environment.fluid_velocity_at(particle.position)), 1e-12)\n",
        "    dt_cfl = EULER_CFL_FRACTION * r / ref_speed\n",
        "    cb, ct = environment.wall_clearances(particle.position, r)\n",
        "    gap = max(min(cb, ct), 1e-15)\n",
        "    dt_wall = EULER_WALL_SAFETY * gap / max(abs(particle.velocity[1]), 1e-12)\n",
        "    if analytic_stokes:\n",
        "        if fast_mode:\n",
        "            return float(np.clip(min(dt_wall, cap), DT_MIN, cap))\n",
        "        dt_flow = EULER_CFL_FRACTION * environment.length / (100.0 * ref_speed)\n",
        "        return float(np.clip(min(dt_flow, dt_wall), DT_MIN, cap))\n",
        "    return float(np.clip(min(dt_cfl, dt_wall, tau / EULER_RELAXATION_STEPS), DT_MIN, cap))\n",
        "\n",
        "\n",
        "def verify_wall_collision_scaling(environment):\n",
        "    print('\\n  [DEBUG] Wall contact thresholds:')\n",
        "    for d in EXPERIMENTAL_DIAMETERS_UM:\n",
        "        r = diameter_um_to_radius_m(d)\n",
        "        t = environment.wall_contact_thresholds(r)\n",
        "        print(f'    {d:.0f} µm (r={r*1e6:.1f} µm): top contact y≤{t[\"top_contact_y_m\"]*1e3:.4f} mm')\n",
        "    r3 = diameter_um_to_radius_m(3.0)\n",
        "    r50 = diameter_um_to_radius_m(50.0)\n",
        "    t3 = environment.wall_contact_thresholds(r3)\n",
        "    t50 = environment.wall_contact_thresholds(r50)\n",
        "    assert t50['top_contact_y_m'] < t3['top_contact_y_m']\n",
        "    print(f'  [DEBUG] 50 µm hits top wall {(t3[\"top_contact_y_m\"]-t50[\"top_contact_y_m\"])*1e6:.1f} µm sooner than 3 µm')\n",
        "    shared_y = environment.width - 3.0e-6\n",
        "    hit3 = environment.check_wall_collision(np.array([0.05, shared_y]), r3)\n",
        "    hit50 = environment.check_wall_collision(np.array([0.05, shared_y]), r50)\n",
        "    print(f'  [DEBUG] Shared center-y={shared_y*1e3:.4f} mm: 3 µm={hit3}  50 µm={hit50}')\n",
        "    assert not hit3 or hit50\n",
        "    if hit50 and not hit3:\n",
        "        print('  [DEBUG] ✓ Radius expands collision envelope — large particle clips wall first')\n",
        "\n",
        "\n",
        "def debug_print_timestep_scaling(environment):\n",
        "    print('\\n  [DEBUG] Adaptive Euler dt at inlet (v=0):')\n",
        "    for d in EXPERIMENTAL_DIAMETERS_UM:\n",
        "        p = Particle.from_diameter_um(d, np.array([diameter_um_to_radius_m(d), environment.centerline_y]))\n",
        "        dt = compute_euler_timestep(p, environment)\n",
        "        print(f'    {d:.0f} µm: dt={dt:.3e} s')\n",
        "\n",
        "\n",
        "def stable_timestep(radius, dynamic_viscosity, density=POLYPROPYLENE_DENSITY):\n",
        "    tau = stokes_relaxation_time(radius, dynamic_viscosity, density)\n",
        "    return float(np.clip(tau / EULER_RELAXATION_STEPS, DT_MIN, DT_MAX))\n",
        "\n",
        "\n",
        "def run_single_trial(environment, diameter_um, trial_id, rng, dt=None, max_time=DEFAULT_MAX_TIME_S,\n",
        "                     debug_first_trial=False, fast_mode=False, record_trajectory=True,\n",
        "                     max_physics_steps=MAX_PHYSICS_STEPS):\n",
        "    diameter_um = normalize_diameter_um(diameter_um)\n",
        "    particle = create_inlet_particle(environment, diameter_um, rng, trial_id)\n",
        "    initial_y = float(particle.position[1])\n",
        "    fixed_dt = dt\n",
        "    step_dt = compute_euler_timestep(particle, environment, fixed_dt=fixed_dt, fast_mode=fast_mode)\n",
        "    times = [0.0] if record_trajectory else []\n",
        "    x_coords = [float(particle.position[0])] if record_trajectory else []\n",
        "    y_coords = [float(particle.position[1])] if record_trajectory else []\n",
        "    time, step_index = 0.0, 0\n",
        "    est = min(int(max_time / max(step_dt, DT_MIN)) + 2, max_physics_steps)\n",
        "    record_stride = max(1, est // MAX_TRAJECTORY_POINTS) if record_trajectory else 1\n",
        "    while time < max_time and particle.state == ParticleState.FLOWING and step_index < max_physics_steps:\n",
        "        step_dt = compute_euler_timestep(particle, environment, fixed_dt=fixed_dt, fast_mode=fast_mode)\n",
        "        particle.update(environment, step_dt)\n",
        "        time += step_dt\n",
        "        step_index += 1\n",
        "        if record_trajectory and step_index % record_stride == 0:\n",
        "            times.append(time); x_coords.append(float(particle.position[0])); y_coords.append(float(particle.position[1]))\n",
        "    if record_trajectory and (not times or times[-1] != time):\n",
        "        times.append(time); x_coords.append(float(particle.position[0])); y_coords.append(float(particle.position[1]))\n",
        "    traj = TrajectoryLog.from_samples(times, x_coords, y_coords) if record_trajectory else TrajectoryLog.from_samples([0],[0],[0])\n",
        "    return TrialResult(trial_id, diameter_um, initial_y, particle.state, time,\n",
        "        particle.position.copy(), particle.velocity.copy(), traj)\n",
        "\n",
        "\n",
        "class ExperimentRunner:\n",
        "    def __init__(self, environment, container_profile, diameters_um=EXPERIMENTAL_DIAMETERS_UM,\n",
        "                 base_trials_per_size=TRIALS_PER_GROUP, dt=None, max_time=DEFAULT_MAX_TIME_S, seed=42, verbose=True,\n",
        "                 debug=False, fast_mode=True, trajectory_trials_per_group=2, max_physics_steps=MAX_PHYSICS_STEPS, data_log=None):\n",
        "        self.environment = environment\n",
        "        self.container_profile = container_profile\n",
        "        self.diameters_um = diameters_um\n",
        "        self.base_trials_per_size = base_trials_per_size\n",
        "        self.trial_counts = container_profile.trial_counts(diameters_um, base_trials_per_size)\n",
        "        self.injection_plan = container_profile.injection_summary(diameters_um, base_trials_per_size)\n",
        "        self.dt, self.max_time, self.seed = dt, max_time, seed\n",
        "        self.verbose, self.debug, self.fast_mode = verbose, debug, fast_mode\n",
        "        self.trajectory_trials_per_group = trajectory_trials_per_group\n",
        "        self.max_physics_steps = max_physics_steps\n",
        "        self.data_log = data_log or ExperimentDataLog()\n",
        "        self.group_results = []\n",
        "\n",
        "    def run_group(self, diameter_um, n_trials, group_seed):\n",
        "        diameter_um = normalize_diameter_um(diameter_um)\n",
        "        self.data_log.reset_group(diameter_um)\n",
        "        tally = self.data_log.get_tally(diameter_um)\n",
        "        trials = []\n",
        "        if self.debug:\n",
        "            debug_print_particle_physics(self.environment, diameter_um, label=f'group {diameter_um:.0f}µm pre-loop')\n",
        "        for trial_id in range(n_trials):\n",
        "            trial_rng = np.random.default_rng(group_seed + trial_id)\n",
        "            record_traj = trial_id < self.trajectory_trials_per_group\n",
        "            result = run_single_trial(self.environment, diameter_um, trial_id, trial_rng, self.dt, self.max_time,\n",
        "                fast_mode=self.fast_mode, record_trajectory=record_traj,\n",
        "                max_physics_steps=self.max_physics_steps, debug_first_trial=self.debug and trial_id == 0)\n",
        "            trials.append(result)\n",
        "            self.data_log.record_trial(diameter_um, result.final_state, result.trajectory)\n",
        "            if self.verbose and n_trials >= 25 and (trial_id + 1) % max(1, n_trials // 4) == 0:\n",
        "                print(f'  {diameter_um:.0f} µm: {trial_id+1}/{n_trials}  escaped {tally.escaped_percent:.1f}%  stuck {tally.stuck_percent:.1f}%')\n",
        "        return GroupResult(diameter_um, trials, n_trials)\n",
        "\n",
        "    def run_all(self):\n",
        "        self.group_results = []\n",
        "        self.data_log.reset_all()\n",
        "        if self.debug:\n",
        "            debug_compare_reference_particles(self.environment)\n",
        "            verify_parabolic_flow_profile(self.environment)\n",
        "            verify_wall_collision_scaling(self.environment)\n",
        "            debug_print_timestep_scaling(self.environment)\n",
        "        if self.verbose:\n",
        "            mode = 'FAST' if self.fast_mode else 'FULL'\n",
        "            print(f\"\\nCONTAINER: {self.container_profile.display_name} [{self.container_profile.comparison_label}]  mode={mode}\")\n",
        "            print(f\"Total particles: {self.injection_plan['total_particles']}\")\n",
        "        for i, d in enumerate(self.diameters_um):\n",
        "            d = normalize_diameter_um(d)\n",
        "            n = self.trial_counts[d]\n",
        "            if self.verbose: print(f\"\\nRunning {d:.0f} µm ({n} trials)\")\n",
        "            group_seed = self.seed + int(d * 1000) + i * 10000 + int(self.container_profile.degradation_factor * 100)\n",
        "            if self.debug: print(f'  [DEBUG] group_seed={group_seed}')\n",
        "            self.group_results.append(self.run_group(d, n, group_seed))\n",
        "        return self.group_results"
      ],
      "execution_count": null,
      "outputs": [],
      "id": "59d287c3"
    },
    {
      "cell_type": "markdown",
