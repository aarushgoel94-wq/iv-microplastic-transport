      "source": [
        "## Cell 6 — Run simulation\n",
        "\n",
        "**Colab-safe defaults below** (~5–10 min). Set `TRIALS_PER_GROUP = 100` and `FAST_MODE = False` only if you have hours to spare."
      ],
      "id": "b4bbbd88"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ── CONFIG (Colab-safe defaults) ─────────────────────────────\n",
        "CONTAINER_KEY = \"pristine\"      # \"pristine\" or \"autoclaved\"\n",
        "TRIALS_PER_GROUP = 25             # 25 ≈ 5–10 min  |  100 ≈ 30+ min\n",
        "FAST_MODE = True                  # coarser dt for 3 µm — required on Colab\n",
        "MAX_TIME_S = 20.0                 # simulated seconds per trial\n",
        "DEBUG = False\n",
        "SEED = 42\n",
        "# ─────────────────────────────────────────────────────────────\n",
        "\n",
        "container = get_container_profile(CONTAINER_KEY)\n",
        "env = TubeEnvironment(\n",
        "    length=0.100, width=0.004,\n",
        "    fluid=FluidProperties(density=SALINE_DENSITY, dynamic_viscosity=SALINE_DYNAMIC_VISCOSITY, average_velocity=0.05),\n",
        ")\n",
        "\n",
        "runner = ExperimentRunner(\n",
        "    env, container,\n",
        "    base_trials_per_size=TRIALS_PER_GROUP,\n",
        "    seed=SEED,\n",
        "    fast_mode=FAST_MODE,\n",
        "    max_time=MAX_TIME_S,\n",
        "    debug=DEBUG,\n",
        "    trajectory_trials_per_group=2,\n",
        ")\n",
        "group_results = runner.run_all()\n",
        "print_experiment_report(group_results, runner.data_log, container, runner.injection_plan)\n",
        "\n",
        "fig1 = plot_trajectory_figure(env, group_results, container)\n",
        "fig2 = plot_outcome_bar_chart(group_results, runner.data_log, container)\n",
        "fig3 = plot_injection_profile_chart(container, runner.injection_plan)\n",
        "plt.show()"
      ],
