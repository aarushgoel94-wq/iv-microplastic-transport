      "source": [
        "## Cell 5 — Text summary & visualization"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import Rectangle\n",
        "\n",
        "SIZE_COLORS = {3.0: \"#2ca02c\", 10.0: \"#ff7f0e\", 50.0: \"#d62728\"}\n",
        "\n",
        "\n",
        "def print_experiment_report(group_results, data_log=None, container_profile=None, injection_plan=None):\n",
        "    total = sum(g.n_trials for g in group_results)\n",
        "    print(\"\\n\" + \"=\" * 62)\n",
        "    print(\"  EXPERIMENTAL RESULTS — DISCRETE OUTCOMES\")\n",
        "    print(\"=\" * 62)\n",
        "    if container_profile:\n",
        "        print(f\"  Container: {container_profile.display_name} [{container_profile.comparison_label}]\")\n",
        "        print(f\"  Degradation: ×{container_profile.degradation_factor:.1f}\")\n",
        "        if injection_plan:\n",
        "            print(f\"  Particles injected: {injection_plan['total_particles']} (baseline {injection_plan['baseline_total']})\")\n",
        "            print(f\"  Sub-20µm share: {injection_plan['sub_20um_fraction']:.1%}\")\n",
        "    print(f\"\\n  Total trials: {total}\")\n",
        "    print(\"  (Physics outcomes below — NOT the same as container injection %)\")\n",
        "    print(f\"  {'Size':<10} {'Trials':>8} {'Escaped %':>12} {'Stuck %':>10}\")\n",
        "    print(\"  \" + \"-\" * 44)\n",
        "    for g in group_results:\n",
        "        t = data_log.get_tally(g.diameter_um) if data_log else None\n",
        "        ep = t.escaped_percent if t else 100 * g.escape_fraction\n",
        "        sp = t.stuck_percent if t else 100 * g.stuck_fraction\n",
        "        print(f\"  {g.diameter_um:<10.0f} {g.n_trials:>8} {ep:>11.1f}% {sp:>9.1f}%\")\n",
        "    print(\"=\" * 62)\n",
        "\n",
        "\n",
        "def _subsample(x, y, max_pts=3000):\n",
        "    if len(x) <= max_pts: return x, y\n",
        "    idx = np.linspace(0, len(x)-1, max_pts, dtype=int)\n",
        "    return x[idx], y[idx]\n",
        "\n",
        "\n",
        "def plot_trajectory_figure(environment, group_results, container_profile=None, samples_per_group=3):\n",
        "    length_mm, width_mm = environment.length * 1e3, environment.width * 1e3\n",
        "    fig, ax = plt.subplots(figsize=(12, 4))\n",
        "    ax.add_patch(Rectangle((0, 0), length_mm, width_mm, fill=False, ec=\"black\", lw=2))\n",
        "    for group in group_results:\n",
        "        color = SIZE_COLORS.get(group.diameter_um, \"gray\")\n",
        "        samples = group.trials[:samples_per_group]\n",
        "        for trial in samples:\n",
        "            x, y = _subsample(trial.trajectory.x_mm, trial.trajectory.y_mm)\n",
        "            ax.plot(x, y, color=color, lw=1.4, alpha=0.85, label=f\"{group.diameter_um:.0f} µm trial {trial.trial_id}\")\n",
        "            mk = \"D\" if trial.final_state == ParticleState.ESCAPED else \"X\" if trial.final_state == ParticleState.STUCK else \"o\"\n",
        "            ax.scatter(trial.trajectory.x_mm[-1], trial.trajectory.y_mm[-1], marker=mk, s=70, c=color, ec=\"black\", zorder=4)\n",
        "    ax.set_xlim(-2, length_mm + 5); ax.set_ylim(-0.3, width_mm + 0.3)\n",
        "    ax.set_aspect(\"equal\"); ax.set_xlabel(\"Axial position (mm)\"); ax.set_ylabel(\"Lateral position (mm)\")\n",
        "    title = \"Microplastic Trajectories in Medical Tubing\"\n",
        "    if container_profile: title += f\"\\n{container_profile.display_name} [{container_profile.comparison_label}]\"\n",
        "    ax.set_title(title); ax.legend(bbox_to_anchor=(1.02, 1), loc=\"upper left\"); fig.tight_layout()\n",
        "    return fig\n",
        "\n",
        "\n",
        "def plot_outcome_bar_chart(group_results, data_log=None, container_profile=None):\n",
        "    diameters = [g.diameter_um for g in group_results]\n",
        "    x = np.arange(len(diameters)); w = 0.35\n",
        "    escape = [data_log.get_tally(g.diameter_um).escaped_percent if data_log else 100*g.escape_fraction for g in group_results]\n",
        "    stuck = [data_log.get_tally(g.diameter_um).stuck_percent if data_log else 100*g.stuck_fraction for g in group_results]\n",
        "    fig, ax = plt.subplots(figsize=(8, 5))\n",
        "    b1 = ax.bar(x - w/2, escape, w, label=\"Escape rate\", color=\"#4c72b0\", ec=\"black\")\n",
        "    b2 = ax.bar(x + w/2, stuck, w, label=\"Wall retention (stuck)\", color=\"#c44e52\", ec=\"black\")\n",
        "    ax.bar_label(b1, fmt=\"%.1f%%\"); ax.bar_label(b2, fmt=\"%.1f%%\")\n",
        "    ax.set_xticks(x); ax.set_xticklabels([f\"{d:.0f} µm\" for d in diameters])\n",
        "    ax.set_xlabel(\"Particle diameter (µm)\"); ax.set_ylabel(\"Percentage of trials (%)\")\n",
        "    title = \"Escape Rate vs. Wall Retention by Particle Size\"\n",
        "    if container_profile: title += f\"\\n{container_profile.comparison_label} — {container_profile.display_name}\"\n",
        "    ax.set_title(title); ax.set_ylim(0, 105); ax.legend(); ax.grid(axis=\"y\", alpha=0.6); fig.tight_layout()\n",
        "    return fig\n",
        "\n",
        "\n",
        "def plot_injection_profile_chart(container_profile, injection_plan):\n",
        "    diameters = sorted(injection_plan[\"trial_counts\"])\n",
        "    counts = [injection_plan[\"trial_counts\"][d] for d in diameters]\n",
        "    fig, ax = plt.subplots(figsize=(8, 5))\n",
        "    bars = ax.bar([f\"{d:.0f} µm\" for d in diameters], counts, color=[SIZE_COLORS.get(d,\"gray\") for d in diameters], ec=\"black\")\n",
        "    ax.bar_label(bars)\n",
        "    ax.set_xlabel(\"Particle diameter (µm)\"); ax.set_ylabel(\"Injected particles (count)\")\n",
        "    ax.set_title(f\"Container Release Profile\\n{container_profile.display_name} (×{container_profile.degradation_factor:.1f})\")\n",
        "    fig.tight_layout(); return fig"
      ],
      "execution_count": null,
      "outputs": [],
      "id": "b1fcf7f7"
    },
